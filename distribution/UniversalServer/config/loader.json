{
  "serverJar": "server.jar",
  "platform": "auto",
  "targetMinecraftVersion": "1.21.11",
  "minimumJavaVersion": 21,
  "minMemory": "512M",
  "maxMemory": "2G",
  "agreeToEula": false,
  "autoRestart": false,
  "scanPlugins": true,
